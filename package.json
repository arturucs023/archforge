{
  "name": "archforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Guía interactiva completa para instalar, configurar y dominar Arch Linux",
  "scripts": {
    "dev": "vite",
    "dev:vm": "node server/vm-server.mjs & vite",
    "build": "tsc && vite build",
    "start": "npm run build && node script/start.mjs",
    "vm": "node server/vm-server.mjs",
    "serve": "vite preview --host 127.0.0.1 --port 4173 --strictPort --open"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/xterm": "^2.0.3",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
